# Port HTTP Express. Samakan dengan port upstream reverse proxy di VPS.
PORT=3001

# PostgreSQL. Gunakan localhost jika database berjalan di mesin yang sama.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmp
# Isi dengan role PostgreSQL yang punya akses ke database CMP.
DB_USER=
DB_PASSWORD=

# Pengaturan login admin saat pertama kali menyiapkan backend.
ADMIN_USER=cmp
ADMIN_PASSWORD=
# Buat nilai acak dengan: openssl rand -hex 32
AUTH_SECRET=

# Opsional untuk VPS.
# NODE_ENV=production
