# Keep false until the API target AND all project/settings data are verified CMP-only.
# This controls live projects, legacy contact data, and public form submission.
# Website appearance overrides can load independently of this flag.
VITE_CMP_API_ENABLED=false

# Leave blank for the Vite dev proxy or a same-origin reverse proxy.
# On a split deployment, set the full backend URL ending in /api before building.
# VITE_API_URL=https://cmp-api.ciptamajupersada.com/api
